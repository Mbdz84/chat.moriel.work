# Copy this file to .env.local and fill in your Supabase values.
# .env.local is git-ignored; never commit real keys.

# Public — safe in the browser (publishable / anon key)
NEXT_PUBLIC_SUPABASE_URL=https://mjrvnzlcmovtplcumbea.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secret — SERVER ONLY. Never expose to the browser. (service_role / secret key)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Public site URL — used to show the correct Twilio webhook URL in Settings
NEXT_PUBLIC_SITE_URL=https://chat.moriel.work

# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXXXXXXXX
VAPID_PRIVATE_KEY=XXXXXXXX
VAPID_SUBJECT=mailto:you@company.com

# Super-admin emails (comma-separated) — platform owners who can create companies/users
SUPERADMIN_EMAILS=you@company.com
